---

<section class="portfolio" id="projects" aria-labelledby="portfolio-heading">
  <div class="wrap">
    <div class="intro">
      <p class="eyebrow">Selected work</p>
      <h2 id="portfolio-heading">Projects built for real businesses</h2>
      <p class="lead">Browse website builds and creative work by industry or project type. Each project shows the tools and work involved.</p>
    </div>

    <div class="filters" role="group" aria-label="Filter projects by category">
      {filters.map((filter, index) => (
        <button class="filter" type="button" data-filter={filter} aria-pressed={index === 0 ? "true" : "false"}>
          {filter}
        </button>
      ))}
    </div>

    <p class="results" data-results aria-live="polite">{projects.length} projects</p>

    <div class="grid" data-project-grid>
      {projects.map((project) => (
        <article class="card" data-category={project.category}>
          <div class="media">
            <img src={project.image} alt={project.alt} loading="lazy" />
            <span class="category">{project.category}</span>
          </div>
          <div class="body">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <ul class="tech" aria-label="Technologies used">
              {project.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
            {project.href ? (
              <a class="visit" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit the ${project.title} website (opens in a new tab)`}>
                Visit live website <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="visit visual-work">Visual project</span>
            )}
          </div>
        </article>
      ))}
    </div>

    <p class="empty" data-empty hidden>No projects are listed in this category yet. Check back soon or contact me to discuss related work.</p>
  </div>

  <script>
    const root = document.querySelector(".portfolio");
    if (root) {
      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
      const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-category]"));
      const empty = root.querySelector<HTMLElement>("[data-empty]");
      const results = root.querySelector<HTMLElement>("[data-results]");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const selected = button.dataset.filter ?? "All";
          let visible = 0;
          buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
          cards.forEach((card) => {
            const show = selected === "All" || card.dataset.category === selected;
            card.hidden = !show;
            if (show) visible += 1;
          });
          if (empty) empty.hidden = visible > 0;
          if (results) results.textContent = `${visible} ${visible === 1 ? "project" : "projects"}`;
        });
      });
    }
  </script>
</section>

<style>
.portfolio { padding: clamp(2.5rem, 6vw, 5rem) 0; color: #f4f6fb; }
.wrap { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
.intro { max-width: 720px; margin: 0 auto 2rem; text-align: center; }
.eyebrow { margin: 0 0 .65rem; color: #9bb0ff; font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.intro h2 { margin: 0; color: #fff; font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.12; font-weight: 700; }
.lead { margin: .9rem auto 0; max-width: 58ch; color: #b8c0d2; line-height: 1.65; }
.filters { display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem; margin: 1.75rem 0 1rem; }
.filter { min-height: 42px; padding: .62rem .92rem; border: 1px solid #343d51; border-radius: 999px; background: #151a25; color: #dce3f1; font: inherit; font-size: .88rem; cursor: pointer; transition: background .18s ease, color .18s ease, border-color .18s ease; }
.filter:hover { border-color: #8299f2; }
.filter[aria-pressed="true"] { color: #101522; border-color: #b7c5ff; background: #b7c5ff; font-weight: 700; }
.filter:focus-visible, .visit:focus-visible { outline: 3px solid #f3c967; outline-offset: 3px; }
.results { min-height: 1.5rem; margin: 0 0 .75rem; color: #939db1; font-size: .88rem; text-align: center; }
.grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
.card { min-width: 0; overflow: hidden; border: 1px solid rgba(191,205,238,.13); border-radius: 18px; background: rgba(20,25,36,.92); box-shadow: 0 12px 28px rgba(0,0,0,.18); }
.card[hidden] { display: none; }
.media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #0b101a; }
.media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
.card:hover .media img { transform: scale(1.025); }
.category { position: absolute; left: .8rem; bottom: .8rem; padding: .42rem .7rem; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; background: rgba(8,12,20,.82); color: #edf1ff; font-size: .78rem; backdrop-filter: blur(8px); }
.body { display: flex; flex-direction: column; align-items: flex-start; padding: 1.15rem; }
.body h3 { margin: 0; color: #fff; font-size: 1.25rem; line-height: 1.25; font-weight: 650; }
.body p { margin: .65rem 0 .8rem; color: #bac2d1; font-size: .96rem; line-height: 1.55; }
.tech { display: flex; flex-wrap: wrap; gap: .45rem; margin: auto 0 .9rem; padding: 0; list-style: none; }
.tech li { padding: .34rem .58rem; border-radius: 6px; background: #222a39; color: #d5dded; font-size: .75rem; }
.visit { display: inline-flex; align-items: center; gap: .35rem; min-height: 42px; color: #bdcaff; font-weight: 650; text-decoration: none; }
.visit:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
.visual-work { color: #99a4ba; font-weight: 500; }
.empty { margin: 1.5rem 0; color: #c2cada; text-align: center; }
@media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.2rem; } .body { padding: 1.25rem; } }
@media (min-width: 1024px) { .wrap { width: min(1200px, calc(100% - 64px)); } .grid { grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1.4rem; } }
@media (prefers-reduced-motion: reduce) { .filter, .media img { transition: none; } }
</style>
