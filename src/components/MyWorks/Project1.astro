---
interface Props { home?: boolean }

const { home = false } = Astro.props;

type Project = {
  title: string;
  image: string;
  category: string;
  technologies: string[];
  summary: string;
  href?: string;
  alt: string;
};

const projects: Project[] = [
  {
    title: "Top Bed Bug Pros",
    image: "/works/Topbedbugpros.jpg",
    category: "Pest Control / Bed Bug",
    technologies: ["Astro", "Sanity CMS"],
    summary: "Responsive pest control website with reusable Sanity content, clear treatment information, and contact paths.",
    href: "https://www.topbedbugpros.com/",
    alt: "Top Bed Bug Pros website displayed on a laptop"
  },
  {
    title: "Bed Bugs Be Gone Now",
    image: "/works/Bbgn.jpg",
    category: "Pest Control / Bed Bug",
    technologies: ["Astro", "Sanity CMS", "SEO"],
    summary: "Bed bug treatment website built with a responsive Astro front end, reusable content, and clear service calls to action.",
    href: "https://bedbugsbegonenow.com/",
    alt: "Bed Bugs Be Gone Now website preview"
  },
  {
    title: "Atlanta Bed Bug Experts",
    image: "/works/atlanta.jpg",
    category: "Pest Control / Bed Bug",
    technologies: ["WordPress", "Gutenberg"],
    summary: "Responsive service website organizing treatment details, service areas, customer reviews, and contact options.",
    href: "https://atlantabedbugexperts.com/",
    alt: "Atlanta Bed Bug Experts website preview"
  },
  {
    title: "Heat Rx",
    image: "/works/hEATRX1.jpg",
    category: "Pest Control / Bed Bug",
    technologies: ["WordPress", "Gutenberg"],
    summary: "Website project for a pest treatment business, presented with a responsive layout and service-focused content.",
    href: "https://heatrx.com/",
    alt: "Heat Rx website preview"
  },
  {
    title: "HeatTech Pest Control",
    image: "/works/Heattech.jpg",
    category: "Pest Control / Bed Bug",
    technologies: ["WordPress", "Gutenberg"],
    summary: "Pest control website project built to present services and help visitors find business information.",
    href: "https://heattechpestcontrol.com/",
    alt: "HeatTech Pest Control website preview"
  },
  {
    title: "Pest Management of Texas",
    image: "/works/PestManagement.jpg",
    category: "Pest Control / Bed Bug",
    technologies: ["WordPress", "Elementor"],
    summary: "Responsive pest management website with service information and clear paths for prospective customers.",
    href: "https://www.pestcontroldallastx.com/",
    alt: "Pest Management of Texas website preview"
  },
  {
    title: "Trojan Roofing",
    image: "/works/Indytojan.jpg",
    category: "Construction",
    technologies: ["WordPress", "Elementor"],
    summary: "Roofing company website with responsive service pages, clear calls to action, and an easy-to-manage layout.",
    href: "https://indytrojanroofing.com/",
    alt: "Trojan Roofing website preview"
  },
  {
    title: "Madden Plumbing",
    image: "/works/madden.jpg",
    category: "Home Services",
    technologies: ["WordPress", "Gutenberg"],
    summary: "Plumbing website organizing services, service areas, reviews, and contact details in an editable block layout.",
    href: "https://maddenplumbingservicesinc.com/",
    alt: "Madden Plumbing website preview"
  },
  {
    title: "Chapman Plumbing",
    image: "/works/chapman.jpg",
    category: "Home Services",
    technologies: ["WordPress", "Gutenberg"],
    summary: "Responsive plumbing website with clear service information, service areas, reviews, and contact options.",
    href: "https://chapmanplumbingal.com/",
    alt: "Chapman Plumbing website preview"
  },
  {
    title: "KMAce Towing Services",
    image: "/works/KMAce Towing Services.jpg",
    category: "Home Services",
    technologies: ["WordPress", "Elementor"],
    summary: "Towing service website project presented with a mobile-friendly layout and direct service information.",
    href: "https://kmacetowing.com/",
    alt: "KMAce Towing Services website preview"
  },
  {
    title: "Wholesale Property Depot",
    image: "/works/Wpdllc.jpg",
    category: "Real Estate",
    technologies: ["WordPress", "Elementor", "PHP", "CSS"],
    summary: "Custom WordPress build with structured property listings and a lightweight, custom-built chat feature.",
    href: "https://wpdllc.net/",
    alt: "Wholesale Property Depot website preview"
  },
  {
    title: "Bed Bug BBQ Campaign Graphics",
    image: "/works/2.png",
    category: "Graphics",
    technologies: ["Graphic Design", "Digital Campaign"],
    summary: "Promotional graphic work created for bed bug treatment marketing.",
    alt: "Bed bug treatment promotional graphics"
  }
];

const filters = [
  "All",
  "Pest Control / Bed Bug",
  "Solar",
  "Healthcare",
  "Beauty",
  "Construction",
  "E-commerce",
  "Landing Pages",
  "Graphics",
  "Home Services",
  "Real Estate"
];

const homeTitles = new Set([
  "Top Bed Bug Pros",
  "Bed Bugs Be Gone Now",
  "Atlanta Bed Bug Experts",
  "Trojan Roofing",
  "Madden Plumbing",
  "Wholesale Property Depot"
]);
const displayedProjects = home ? projects.filter((project) => homeTitles.has(project.title)) : projects;
const displayedFilters = home
  ? ["All", "Pest Control / Bed Bug", "Beauty", "E-commerce", "Construction", "Home Services", "Real Estate"]
  : filters;
---

<section class:list={["portfolio", { "portfolio--home": home }]} id="projects" aria-labelledby="portfolio-heading" data-portfolio>
  <div class="wrap">
    <div class="intro">
      <p class="eyebrow">Selected work</p>
      <h2 id="portfolio-heading">{home ? "Selected Website Projects" : "Projects built for real businesses"}</h2>
      <p class="lead">{home ? "Explore selected website projects by industry, then browse the full portfolio for more work." : "Browse website builds and creative work by industry or project type. Each project shows the tools and work involved."}</p>
    </div>

    <div class="filters" role="group" aria-label="Filter projects by category">
      {displayedFilters.map((filter, index) => {
        const count = filter === "All" ? displayedProjects.length : displayedProjects.filter((project) => project.category === filter).length;
        return (
        <button class="filter" type="button" data-filter={filter} aria-pressed={index === 0 ? "true" : "false"}>
          {filter}
          {home && <span class="filter-count" aria-label={`${count} ${count === 1 ? "project" : "projects"}`}>
            {count}
          </span>}
        </button>
        );
      })}
    </div>

    <p class="results" data-results aria-live="polite">{displayedProjects.length} projects</p>

    <div class="grid" data-project-grid data-visible={displayedProjects.length}>
      {displayedProjects.map((project) => (
        <article class="card" data-category={project.category}>
          <div class="media">
            <img src={project.image} alt={project.alt} loading="lazy" />
            <span class="category">{project.category}</span>
          </div>
          <div class="body">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <ul class="tech" aria-label="Technologies used">
              {project.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
            {project.href ? (
              <a class="visit" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit the ${project.title} website (opens in a new tab)`}>
                Visit live website <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="visit visual-work">Visual project</span>
            )}
          </div>
        </article>
      ))}
    </div>

    <p class="empty" data-empty hidden>No projects are listed in this category yet. Check back soon or contact me to discuss related work.</p>
    {home && <div class="all-projects"><a href="/Myworksindex/">View all projects <span aria-hidden="true">↗</span></a></div>}
  </div>

  <script>
    document.querySelectorAll<HTMLElement>("[data-portfolio]").forEach((root) => {
      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
      const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-category]"));
      const empty = root.querySelector<HTMLElement>("[data-empty]");
      const results = root.querySelector<HTMLElement>("[data-results]");
      const grid = root.querySelector<HTMLElement>("[data-project-grid]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let change = 0;

      buttons.forEach((button) => {
        button.addEventListener("click", async () => {
          if (button.getAttribute("aria-pressed") === "true") return;
          const currentChange = ++change;
          const selected = button.dataset.filter ?? "All";
          cards.forEach((card) => card.getAnimations().forEach((animation) => animation.cancel()));
          buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));

          if (!reducedMotion.matches) {
            await Promise.all(cards.filter((card) => !card.hidden).map((card) =>
              card.animate(
                [{ opacity: 1, transform: "translateY(0)" }, { opacity: 0, transform: "translateY(-10px)" }],
                { duration: 150, easing: "ease-in", fill: "forwards" }
              ).finished.catch(() => {})
            ));
          }
          if (currentChange !== change) return;

          const shown: HTMLElement[] = [];
          cards.forEach((card) => {
            const show = selected === "All" || card.dataset.category === selected;
            card.hidden = !show;
            if (show) shown.push(card);
          });
          if (empty) {
            empty.hidden = shown.length > 0;
            if (!shown.length) empty.textContent = `No ${selected.toLowerCase()} projects are featured here yet. Browse the full portfolio or check back soon.`;
          }
          if (results) results.textContent = `${shown.length} ${shown.length === 1 ? "project" : "projects"}`;
          grid?.setAttribute("data-visible", String(shown.length));

          cards.forEach((card) => card.getAnimations().forEach((animation) => animation.cancel()));
          if (!reducedMotion.matches) {
            shown.forEach((card, index) => card.animate(
              [{ opacity: 0, transform: "translateY(18px) scale(.98)" }, { opacity: 1, transform: "translateY(0) scale(1)" }],
              { duration: 380, delay: Math.min(index, 8) * 45, easing: "cubic-bezier(.22,.61,.36,1)" }
            ));
          }
        });
      });
    });
  </script>
</section>

<style>
.portfolio { padding: clamp(2.5rem, 6vw, 5rem) 0; color: #f4f6fb; }
.wrap { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
.intro { max-width: 720px; margin: 0 auto 2rem; text-align: center; }
.eyebrow { margin: 0 0 .65rem; color: #9bb0ff; font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.intro h2 { margin: 0; color: #fff; font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.12; font-weight: 700; }
.lead { margin: .9rem auto 0; max-width: 58ch; color: #b8c0d2; line-height: 1.65; }
.filters { display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem; margin: 1.75rem 0 1rem; }
.filter { min-height: 42px; padding: .62rem .92rem; border: 1px solid #343d51; border-radius: 999px; background: #151a25; color: #dce3f1; font: inherit; font-size: .88rem; cursor: pointer; transition: background .18s ease, color .18s ease, border-color .18s ease; }
.filter:hover { border-color: #8299f2; }
.filter[aria-pressed="true"] { color: #101522; border-color: #b7c5ff; background: #b7c5ff; font-weight: 700; }
.filter-count { display: inline-grid; min-width: 1.35rem; height: 1.35rem; margin-left: .45rem; padding: 0 .2rem; place-items: center; border-radius: 999px; background: rgba(255,255,255,.12); font-size: .7rem; font-weight: 700; }
.filter[aria-pressed="true"] .filter-count { background: rgba(16,21,34,.13); }
.filter:focus-visible, .visit:focus-visible { outline: 3px solid #f3c967; outline-offset: 3px; }
.results { min-height: 1.5rem; margin: 0 0 .75rem; color: #939db1; font-size: .88rem; text-align: center; }
.grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
.grid[data-visible="1"] { max-width: 380px; margin-inline: auto; }
.card { min-width: 0; overflow: hidden; border: 1px solid rgba(191,205,238,.13); border-radius: 18px; background: rgba(20,25,36,.92); box-shadow: 0 12px 28px rgba(0,0,0,.18); }
.card[hidden] { display: none; }
.media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #0b101a; }
.media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
.card:hover .media img { transform: scale(1.025); }
.category { position: absolute; left: .8rem; bottom: .8rem; padding: .42rem .7rem; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; background: rgba(8,12,20,.82); color: #edf1ff; font-size: .78rem; backdrop-filter: blur(8px); }
.body { display: flex; flex-direction: column; align-items: flex-start; padding: 1.15rem; }
.body h3 { margin: 0; color: #fff; font-size: 1.25rem; line-height: 1.25; font-weight: 650; }
.body p { margin: .65rem 0 .8rem; color: #bac2d1; font-size: .96rem; line-height: 1.55; }
.tech { display: flex; flex-wrap: wrap; gap: .45rem; margin: auto 0 .9rem; padding: 0; list-style: none; }
.tech li { padding: .34rem .58rem; border-radius: 6px; background: #222a39; color: #d5dded; font-size: .75rem; }
.visit { display: inline-flex; align-items: center; gap: .35rem; min-height: 42px; color: #bdcaff; font-weight: 650; text-decoration: none; }
.visit:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
.visual-work { color: #99a4ba; font-weight: 500; }
.empty { margin: 1.5rem 0; color: #c2cada; text-align: center; }
.all-projects { margin-top: 2rem; text-align: center; }
.all-projects a { display: inline-flex; align-items: center; gap: .6rem; min-height: 48px; padding: .75rem 1.25rem; border-radius: 999px; background: #b7c5ff; color: #101522; font-weight: 750; text-decoration: none; transition: transform .2s ease, background .2s ease; }
.all-projects a:hover { transform: translateY(-2px); background: #d3dcff; }
.all-projects a:focus-visible { outline: 3px solid #f3c967; outline-offset: 3px; }
@media (max-width: 639px) { .portfolio--home .filters { justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; padding: .25rem 0 .75rem; scrollbar-width: thin; scroll-snap-type: x proximity; } .portfolio--home .filter { flex: 0 0 auto; scroll-snap-align: start; } }
@media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.2rem; } .body { padding: 1.25rem; } }
@media (min-width: 1024px) { .wrap { width: min(1200px, calc(100% - 64px)); } .grid { grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1.4rem; } }
@media (prefers-reduced-motion: reduce) { .filter, .media img, .all-projects a { transition: none; } }
</style>
